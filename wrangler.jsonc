{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "winslow-pantry",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Regenerates the pages from src/ before every deploy.
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serves the nearest 404.html, so /es/... and /fr/... get a translated page.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The internal style guide goes through the Worker for auth, and /email
    // through the Worker so the inbox address never ships in a page.
    "run_worker_first": ["/styleguide", "/styleguide/*", "/email"]
  },
  // Matches the dashboard: keep request logs, including invocation logs.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
